{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "url", "timeZone", "storageClass", "storage", "images", "resources"],
  "properties": {
    "existingSecret": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "url": {"type": "string", "pattern": "^https?://[^/]+$"},
    "timeZone": {"type": "string", "minLength": 1},
    "storageClass": {"type": "string"},
    "images": {"type": "object", "required": ["app", "postgres", "broker"], "additionalProperties": {"type": "string", "minLength": 1}},
    "storage": {"type": "object", "required": ["app", "postgres", "broker"], "additionalProperties": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}},
    "resources": {"type": "object", "required": ["app", "postgres", "broker"]}
  },
  "additionalProperties": false
}
